{
  "expo": {
    "name": "BeggarsMap",
    "slug": "BeggarsMap",
    "scheme": "beggarsmap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beggarsmap.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Beggars Map uses your location to show cheap eats near you and to drop a pin when you add a listing."
      }
    },
    "android": {
      "package": "com.beggarsmap.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Beggars Map uses your location to show cheap eats near you and to drop a pin when you add a listing."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5dafff54-dde5-4b24-b2a5-ff9a9eb3098d"
      }
    }
  }
}

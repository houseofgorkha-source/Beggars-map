# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# Supabase CLI session-local link state
supabase/.temp/

# local DB backups (scripts/backup-local-db.mjs) — never intended for source control
supabase/backups/

# discovery pipeline (tools/discovery/) — dry-run/candidate output and API
# call logs are local scratch data, never intended for source control
tools/discovery/output/
tools/discovery/*.log
# source photos staged for import: input data (and third-party imagery),
# not code — the importer reads them from disk, nothing needs them in git
tools/discovery/photos/

# generated native folders
/ios
/android
